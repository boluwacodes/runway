PORT=3030
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
RUNWAY_CONTRACT_ID=
DB_PATH=./runway.sqlite
# How often the background indexer re-reads the contract, in ms (default 8000,
# minimum 1000). Raise it on a rate-limited RPC plan.
INDEXER_INTERVAL_MS=8000
# Shared secret required as the x-api-key header on POST /sync. Leave unset
# for local dev; always set it in any deployed environment (issue #1).
SYNC_API_KEY=
