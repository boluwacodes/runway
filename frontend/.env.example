NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_RUNWAY_CONTRACT_ID=
# The native XLM Stellar Asset Contract (SAC) address on the target network
# (get it with `stellar contract id asset --asset native --network testnet`).
# Used to label an invoice's asset as "XLM" vs. showing its raw contract
# address when a payee chose a different asset at creation time.
NEXT_PUBLIC_NATIVE_TOKEN_ID=
# Optional — the indexer/API in backend/. Falls back to slower on-chain
# event-log discovery automatically if this is unset or unreachable.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3030
